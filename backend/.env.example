MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
NODE_ENV=development
APP_PORT=4000
LOG_LEVEL=info
LOG_SILENT=false
CORS_ORIGIN=http://localhost:5173
APP_ACCESS_TOKEN_FILE=/run/secrets/access_token
APP_REFRESH_TOKEN_FILE=/run/secrets/refresh_token
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_zzzzzzzzz
APP_EMAIL=nexora@resend.dev
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID_FILE=/run/secrets/aws_access_key_id
AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/aws_secret_access_key
AWS_CLOUDFRONT_DOMAIN=https://your-domain.com
AWS_CLOUDFRONT_KEY_PAIR_ID=your-key-pair
AWS_CLOUDFRONT_PRIVATE_KEY_SECRET_NAME=your-key-secret-name
AWS_CLOUDFRONT_REGION=us-east-1
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id